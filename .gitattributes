# --- Normalize line endings for common file types ---

# Force LF for code and notebooks
*.py     text eol=lf
*.ipynb  text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Windows-specific files can stay CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# --- Binary files (Git should never modify these) ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.exe    binary
*.dll    binary
